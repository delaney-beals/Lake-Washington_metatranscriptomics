# Process samples                                                                                                                                                                                                                            for sample in $(awk '{print $1}' samples.txt)                                                                                                                                                                                                do                                                                                                                                                                                                                                               echo "Processing sample: $sample"                                                                                                                                                                                                            input_file="/scratch/general/vast/u1260626/21113R/${sample}.interleaved.atrim.decontam.fq.gz"                                                                                                                                                output_file="/scratch/general/vast/u1260626/21113R/${sample}.interleaved.atrim.decontam.fastp.fq.gz"                                                                                                                                         if [[ -f "$input_file" ]]; then                                                                                                                                                                                                                  fastp --thread 12 --cut_front --cut_window_size 8 --cut_mean_quality 28 --interleaved_in -i "$input_file" --stdout > "$output_file"                                                                                                      else                                                                                                